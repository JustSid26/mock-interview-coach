# Required: Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here


#default model
GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_MODEL=llama-3.1-8b-instant # lighter quota on free tier

# Model (default: llama-3.1-8b-instant — lighter quota on free tier)
# If you hit daily limits on 70b, use 8b-instant or wait for quota reset
# Fallback when primary model returns 429 (optional)
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: API timeout in seconds (default 45)
# GROQ_TIMEOUT_SEC=45
